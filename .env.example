COMPOSE_PROJECT_NAME=siga_inebi
POSTGRES_DB=siga_inebi
POSTGRES_USER=siga_inebi
POSTGRES_PASSWORD=siga_inebi_dev_password
POSTGRES_PORT=5432
# RNF-LOC-001: zona horaria del establecimiento. Aplica al servidor, a la base
# de datos y a la interpretacion de eventos y fechas de efecto.
TIME_ZONE=America/Guatemala
# RNF-REN-004: ventana en hora local en la que el proceso trabajador puede
# drenar la cola de trabajos diferidos. Por defecto arranca despues del cierre
# de jornada y termina antes de la entrada, para no competir con el escaneo.
# Inicio y fin iguales significan drenar todo el dia.
WORKER_WINDOW_START=19:00
WORKER_WINDOW_END=05:00
WORKER_POLL_SECONDS=5
BACKEND_PORT=8000
FRONTEND_PORT=5173
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_EMAIL=admin@admin.com
DEMO_ADMIN_PASSWORD=admin
